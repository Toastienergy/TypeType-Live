FROM golang:1.27-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /out/faketwitch ./tools/faketwitch \
 && CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /out/loadgen ./tools/loadgen

FROM scratch
COPY --from=build /out/faketwitch /faketwitch
COPY --from=build /out/loadgen /loadgen
USER 65532:65532
